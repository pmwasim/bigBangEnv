{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin claude/*)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push --set-upstream origin claude/*)",
      "Bash(git push origin experiment/*)",
      "Bash(git push -u origin experiment/*)",
      "Bash(git push --set-upstream origin experiment/*)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git rebase *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(python3 -m pytest *)",
      "Bash(python -m pytest *)",
      "Bash(pytest *)",
      "Bash(bigbang eval *)",
      "Bash(bigbang status *)",
      "Bash(bigbang trace *)",
      "Bash(bigbang replay *)",
      "Bash(python3 examples/first_light.py)",
      "Bash(examples/caretaker/operate.sh *)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git rebase -i *)",
      "Bash(git rebase --interactive *)",
      "Bash(git push * --delete *)",
      "Bash(git push * --delete)",
      "Bash(git push * -d *)",
      "Bash(git push * -d)",
      "Bash(git push * :*)",
      "Bash(git push * --prune *)",
      "Bash(git push * --prune)",
      "Bash(git push * --tags)",
      "Bash(git push * --tags *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * --force-with-lease)",
      "Bash(git push * --force-with-lease *)",
      "Bash(git push * --force-with-lease=*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push --mirror *)",
      "Bash(git push * --mirror *)",
      "Bash(git push * --mirror)",
      "Bash(git push --all *)",
      "Bash(git push * --all *)",
      "Bash(git push * --all)",
      "Bash(git push *+*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git reset --hard *)",
      "Bash(git * reset --hard *)",
      "Bash(git * reset --hard)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(env)",
      "Bash(printenv *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)"
    ]
  }
}

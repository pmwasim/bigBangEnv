[Unit]
Description=bigBangEnv Shared World Environment Daemon
Documentation=https://github.com/pmwasim/bigBangEnv
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/bigbang-world
Environment=PYTHONPATH=/opt/bigbang-world/src
ExecStart=/usr/bin/python3 -m bigbang world serve --state /var/lib/bigbang-world/world.json --host 0.0.0.0 --port 8787 --interval 2.0
Restart=on-failure
RestartSec=3s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bigbang-world

[Install]
WantedBy=multi-user.target
